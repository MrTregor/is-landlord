# Переменные окружения «Наймодателя» (docs/spec/03 Архитектура и репозиторий.md).
# Для разработки: cp .env.example .env — значения ниже рассчитаны на make dev (server, worker и Vite на машине,
# остальное — в docker-compose.yml). На сервере все пароли и ключи заменить (docs/spec/18, раздел 6).
# Значения с пробелами и знаками < > пишутся в двойных кавычках (файл читают docker compose и оболочка).

# Режим: dev | demo | prod. demo включает сдвиг времени и служебные методы /api/v1/dev/*
APP_ENV=dev
# Название в интерфейсе, письмах и документах
APP_NAME="Наймодатель"
# Внешний адрес (ссылки в письмах, адрес расчётов в чеке)
APP_PUBLIC_URL=http://localhost:5173
# Адрес сервера API
HTTP_ADDR=:8080

# --- База данных (PostgreSQL 18)
# Пароли ролей; используются docker-compose (контейнер postgres и deploy/db-init/01-roles.sh)
DB_OWNER_PASSWORD=owner-dev-password
DB_APP_PASSWORD=app-dev-password
# Подключение приложения (роль landlord_app: без UPDATE/DELETE/TRUNCATE на audit_log)
DATABASE_URL=postgres://landlord_app:app-dev-password@localhost:5432/landlord?sslmode=disable
# Подключение для миграций (владелец схемы landlord_owner)
DATABASE_MIGRATE_URL=postgres://landlord_owner:owner-dev-password@localhost:5432/landlord?sslmode=disable

# Часовой пояс бизнес-дат
TZ_BUSINESS=Europe/Moscow
# Каталог файлов (фото, сканы, PDF) и предельный размер загрузки, МБ
FILES_DIR=./data/files
MAX_UPLOAD_MB=10
# Каталог резервных копий (только чтение, экран «Настройки → Служебное»)
BACKUPS_DIR=./data/backups

# Ключ шифрования паспортных данных: 32 байта в base64 (openssl rand -base64 32).
# Значение ниже — только для разработки. Ключ хранится отдельно от резервных копий.
PDN_ENC_KEY=ZGV2LW9ubHkta2V5LWRvLW5vdC11c2UtaW4tcHJvZCE=

# --- Сессии
SESSION_IDLE_HOURS=8
SESSION_ABSOLUTE_DAYS=30
# Флаг Secure у cookie (false только в dev — Vite работает по http)
COOKIE_SECURE=false

# --- Почта (в разработке — Mailpit, веб-интерфейс http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
# none | starttls | tls
SMTP_TLS=none
MAIL_FROM="Наймодатель <no-reply@landlord.local>"

# --- PDF (Gotenberg)
GOTENBERG_URL=http://localhost:3000

# --- Онлайн-оплата: протокол Т-Банк эквайринг (в проекте — эмулятор mocks/tbank)
# Настоящий: https://securepay.tinkoff.ru/v2
TBANK_API_URL=http://localhost:8081/v2
TBANK_TERMINAL_KEY=LandlordDemo
TBANK_PASSWORD=demo-terminal-password
# Куда эмулятор шлёт уведомления (из контейнера на машину разработчика)
TBANK_NOTIFICATION_URL=http://host.docker.internal:8080/api/v1/integrations/tbank/notify

# --- Фискализация: протокол АТОЛ Онлайн v5 (в проекте — эмулятор mocks/atol)
# Настоящий тестовый: https://testonline.atol.ru/possystem/v5
ATOL_API_URL=http://localhost:8082/possystem/v5
ATOL_LOGIN=demo
ATOL_PASSWORD=demo
ATOL_GROUP_CODE=landlord-demo
ATOL_CALLBACK_URL=http://host.docker.internal:8080/api/v1/integrations/atol/callback

# Разрешить сдвиг времени (только при APP_ENV=demo)
DEMO_CLOCK_ENABLED=false
# Уровень журнала: debug | info | warn | error
LOG_LEVEL=info

# --- Только docker-compose.prod.yml (этап M15)
APP_DOMAIN=localhost
MAILPIT_PASSWORD=change-me
VERSION=dev
