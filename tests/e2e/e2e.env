# Переменные стека demo для сквозных и нагрузочных тестов (make e2e, make load): docker-compose.prod.yml --profile demo.
# Значения условные, только для локальной проверки.
COMPOSE_PROJECT_NAME=landlord-e2e
ENV_FILE=tests/e2e/e2e.env
VERSION=dev
APP_DOMAIN=localhost
APP_ENV=demo
DEMO_CLOCK_ENABLED=true
APP_NAME="Наймодатель"
APP_PUBLIC_URL=https://localhost
DB_OWNER_PASSWORD=e2e-owner-password
DB_APP_PASSWORD=e2e-app-password
MAILPIT_PASSWORD=e2e-mailpit
PDN_ENC_KEY=ZTJlLW9ubHkta2V5LWRvLW5vdC11c2UtaW4tcHJvZCE=
TZ_BUSINESS=Europe/Moscow
MAX_UPLOAD_MB=10
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_TLS=none
MAIL_FROM="Наймодатель <no-reply@landlord.local>"
TBANK_API_URL=http://tbank-mock:8081/v2
TBANK_TERMINAL_KEY=LandlordDemo
TBANK_PASSWORD=demo-terminal-password
TBANK_NOTIFICATION_URL=http://server:8080/api/v1/integrations/tbank/notify
ATOL_API_URL=http://atol-mock:8082/possystem/v5
ATOL_LOGIN=demo
ATOL_PASSWORD=demo
ATOL_GROUP_CODE=landlord-demo
ATOL_CALLBACK_URL=http://server:8080/api/v1/integrations/atol/callback
LOG_LEVEL=info
